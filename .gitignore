# Keep personal datasets and generated artifacts out of the public repository.
/*
!/.github/
!/.gitattributes
!/.gitignore
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/CHANGELOG.md
!/PUBLICATION-STATUS.md
!/pyproject.toml
!/MANIFEST.in
!/demo.py
!/config.example.json
!/rights.template.json
!/prospect/
!/fixtures/
!/profiles/
!/tests/
!/scripts/
!/docs/

__pycache__/
*.py[cod]
*.sqlite3
*.sqlite3-*
.venv/
*.sqlite
*.db
venv/
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.log
*.egg-info/
build/
dist/
wheelhouse/
local-data/
demo-output/
prospect-review-workspace/

# Local coordination and verification receipts are not public source material.
/docs/handoffs/
/docs/planning/
/docs/verification/
